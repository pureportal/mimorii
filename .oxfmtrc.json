{
  "printWidth": 100,
  "singleQuote": false,
  "trailingComma": "es5",
  "overrides": [
    {
      "files": ["*.code-workspace"],
      "options": {
        "trailingComma": "none"
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/target/**",
    "**/src-tauri/gen/**",
    "**/*.openapi.json",
    "**/permissions/autogenerated/**",
    "**/permissions/schemas/**",
    "**/migrations/.snapshot-*_test_*.json"
  ]
}
