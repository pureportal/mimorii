{
  "name": "mimorii",
  "version": "2.0.1",
  "private": true,
  "description": "Self-hosted uptime, infrastructure analytics, and observability.",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build && pnpm run agent-deskopt:build && pnpm run agent-mobile:build",
    "build:client": "pnpm --filter @mimorii/client build",
    "build:api": "pnpm --filter @mimorii/api build",
    "db:create": "pnpm --filter @mimorii/api db:create",
    "db:up": "pnpm --filter @mimorii/api db:up",
    "db:down": "pnpm --filter @mimorii/api db:down",
    "db:list": "pnpm --filter @mimorii/api db:list",
    "db:pending": "pnpm --filter @mimorii/api db:pending",
    "db:check": "pnpm --filter @mimorii/api db:check",
    "check": "pnpm run release:validate && pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "dev": "pnpm run seed && node scripts/dev.mjs",
    "dev:api": "pnpm --filter @mimorii/api dev",
    "dev:agent-deskopt": "cargo run --manifest-path apps/agent-deskopt/Cargo.toml -- run",
    "dev:client": "pnpm --filter @mimorii/client dev",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "pnpm --filter @mimorii/contracts build && oxlint --type-aware .",
    "typecheck": "pnpm --filter @mimorii/contracts build && pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test && pnpm run agent-deskopt:test && pnpm run agent-mobile:test",
    "test:e2e": "pnpm --filter @mimorii/api test:e2e",
    "seed": "pnpm --filter @mimorii/api seed",
    "openapi": "pnpm --filter @mimorii/api openapi:generate",
    "swetrix:configure": "node scripts/configure-swetrix.mjs",
    "swetrix:verify": "node scripts/verify-swetrix.mjs",
    "agent-deskopt:check": "cargo check --manifest-path apps/agent-deskopt/Cargo.toml",
    "agent-deskopt:test": "cargo test --manifest-path apps/agent-deskopt/Cargo.toml",
    "agent-deskopt:build": "cargo build --release --manifest-path apps/agent-deskopt/Cargo.toml",
    "agent-mobile:check": "cargo check --manifest-path apps/agent-mobile/Cargo.toml",
    "agent-mobile:test": "cargo test --manifest-path apps/agent-mobile/Cargo.toml",
    "agent-mobile:build": "cargo build --release --manifest-path apps/agent-mobile/Cargo.toml",
    "release:validate": "node scripts/validate-release.mjs",
    "tauri:build": "pnpm run release:validate && pnpm --filter @mimorii/client tauri:build",
    "tauri:android:init": "pnpm run release:validate && pnpm --filter @mimorii/client tauri:android:init && node scripts/configure-android-project.mjs",
    "tauri:android:build": "pnpm run release:validate && node scripts/configure-android-project.mjs && pnpm --filter @mimorii/client tauri:android:build",
    "tauri:android:sign": "node scripts/sign-android-apk.mjs",
    "tauri:android:release": "pnpm run tauri:android:build && pnpm run tauri:android:sign",
    "tauri:windows:build": "pnpm run release:validate && node scripts/build-windows-client.mjs",
    "tauri:windows:stage": "node scripts/stage-windows-installers.mjs",
    "tauri:windows:release": "pnpm run tauri:windows:build && pnpm run tauri:windows:stage"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ]
  }
}
