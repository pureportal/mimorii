{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mimorii Agent",
  "identifier": "app.mimorii.agent",
  "app": {
    "security": {
      "capabilities": [
        {
          "identifier": "android-agent",
          "windows": ["main"],
          "permissions": ["core:default", "agent-mobile:default", "push:default"]
        }
      ]
    }
  }
}
