{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mimorii",
  "mainBinaryName": "Mimorii",
  "version": "8.0.0",
  "identifier": "app.mimorii.monitor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "pnpm --filter @mimorii/client... build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mimorii",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' http: https:; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "PurePortal",
    "homepage": "https://github.com/pureportal/mimorii",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
