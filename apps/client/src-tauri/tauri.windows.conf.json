{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "app.mimorii.monitor",
  "bundle": {
    "targets": ["nsis", "msi"],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "tsp": false,
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "upgradeCode": "9cf97636-ac39-526f-8bd9-82daef03c74a",
        "language": "en-US"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English"],
        "compression": "lzma"
      }
    }
  }
}
