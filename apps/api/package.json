{
  "name": "@mimorii/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "predev": "pnpm run clean",
    "dev": "tsc-watch --noClear --project tsconfig.json --onSuccess \"node dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:e2e": "vitest run test/api.e2e.test.ts",
    "db:create": "mikro-orm migration:create --config src/mikro-orm.config.ts",
    "db:up": "mikro-orm migration:up --config src/mikro-orm.config.ts",
    "db:down": "mikro-orm migration:down --config src/mikro-orm.config.ts",
    "db:list": "mikro-orm migration:list --config src/mikro-orm.config.ts",
    "db:pending": "mikro-orm migration:pending --config src/mikro-orm.config.ts",
    "db:check": "mikro-orm migration:check --config src/mikro-orm.config.ts",
    "seed": "tsx src/database/seed.ts",
    "openapi:generate": "pnpm run build && node dist/openapi/generate.js"
  },
  "dependencies": {
    "@mikro-orm/core": "6.6.14",
    "@mikro-orm/migrations": "6.6.14",
    "@mikro-orm/nestjs": "6.1.1",
    "@mikro-orm/postgresql": "6.6.14",
    "@mimorii/contracts": "workspace:*",
    "@nestjs/common": "^11.1.21",
    "@nestjs/core": "^11.1.21",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.21",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.4.3",
    "@nestjs/throttler": "^6.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "17.3.1",
    "express": "^5.1.0",
    "firebase-admin": "14.2.0",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.3.0",
    "nodemailer": "^9.0.5",
    "pg": "8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@mikro-orm/cli": "6.6.14",
    "@nestjs/testing": "^11.1.21",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^6.0.3",
    "@types/web-push": "3.6.4",
    "supertest": "^7.2.2",
    "ts-node": "10.9.2",
    "tsc-watch": "^7.2.1",
    "tsx": "^4.21.0",
    "vitest": "^4.1.5"
  }
}
